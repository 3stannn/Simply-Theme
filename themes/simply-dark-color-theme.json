    "editorBracketHighlight.foreground3": "#679BD2",
    "editorError.foreground": "#EC8F93",
    "editorWarning.foreground": "#E5BC83",
    "editorInfo.foreground": "#8ABBE0",
    "editorGutter.addedBackground": "#A4C98C",
