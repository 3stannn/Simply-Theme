    "editorLineNumber.foreground": "#767676",
    "editorLineNumber.activeForeground": "#F5F5F5",
    "editor.lineHighlightBackground": "#202020",
    "editor.selectionBackground": "#424242",
    "editor.inactiveSelectionBackground": "#333333",
